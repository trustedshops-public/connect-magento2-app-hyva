<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Hyva\CompatModuleFallback\Model\CompatModuleRegistry">
        <arguments>
            <argument name="compatModules" xsi:type="array">
                <item name="trustedshops-hyva-easy-integration" xsi:type="array">
                    <item name="original_module" xsi:type="string">Trustedshops_EasyIntegration</item>
                    <item name="compat_module" xsi:type="string">Trustedshops_HyvaEasyIntegration</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!--
        Hyvä has none of the Luma header controls the Trstd Login element anchors to, but
        Magento's core layout still declares the unused "header-wrapper" container, which
        would put the element on a line of its own above the header. Place it in the Hyvä
        header icon row instead; on the checkout page the header template of this module
        renders the same container.
    -->
    <type name="Trustedshops\EasyIntegration\Observer\TrstdLoginPlacement">
        <arguments>
            <argument name="headerContainers" xsi:type="array">
                <item name="header-content.additional" xsi:type="number">5</item>
            </argument>
        </arguments>
    </type>
</config>
